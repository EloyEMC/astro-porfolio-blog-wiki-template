---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date } = post.data;
---

<article class="legacy-post-card legacy-post-card--compact">
  <header>
    <h2 class="legacy-post-title">
      <a href={`/blog/${post.slug}`}>{title}</a>
    </h2>
    <div class="legacy-post-date">
      <PostDate date={date} />
    </div>
  </header>
  <p class="legacy-post-description">{description}</p>
</article>
