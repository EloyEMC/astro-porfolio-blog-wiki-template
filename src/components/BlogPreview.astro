---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';
import PostTags from './PostTags.astro';
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;

// Ensure image dimensions are available to prevent CLS
const imageWidth = 800;
const imageHeight = 400;
---

<article class:list={["legacy-post-card", { "legacy-post-card--image": image }]}>
  {image && (
    <a href={`/blog/${post.slug}`} class="legacy-post-background" aria-label={title}>
      <Image
        src={image}
        alt={title}
        width={imageWidth}
        height={imageHeight}
        decoding="async"
        loading="eager"
        class="legacy-post-image"
      />
    </a>
  )}
  <div class="legacy-post-card-content">
    <header>
      <h2 class="legacy-post-title">
        <a href={`/blog/${post.slug}`}>{title}</a>
      </h2>
      <div class="legacy-post-date">
        <PostDate date={date} />
      </div>
    </header>
    <p class="legacy-post-description">{description}</p>
    {tags && <PostTags tags={tags} />}
  </div>
</article>
