---
interface Props {
  measurementId?: string;
}

const { measurementId } = Astro.props;
---

<div class="cookie-consent" data-cookie-consent data-measurement-id={measurementId} aria-live="polite">
  <section class="cookie-consent-banner" data-cookie-banner hidden aria-labelledby="cookie-consent-title">
    <div>
      <h2 id="cookie-consent-title">Preferencias de cookies</h2>
      <p>Usamos almacenamiento técnico para recordar preferencias y, solo con tu permiso, Google Analytics para medir el uso del sitio de forma anónima y agregada.</p>
    </div>
    <div class="cookie-consent-actions">
      <button type="button" data-cookie-accept>Aceptar analítica</button>
      <button type="button" data-cookie-reject>Rechazar</button>
      <button type="button" data-cookie-open>Configurar</button>
    </div>
  </section>

  <button type="button" class="cookie-settings-link" data-cookie-settings hidden>Configurar cookies</button>

  <div class="cookie-consent-dialog" data-cookie-dialog hidden>
    <div class="cookie-consent-backdrop" data-cookie-close></div>
    <section class="cookie-consent-panel" role="dialog" aria-modal="true" aria-labelledby="cookie-settings-title" aria-describedby="cookie-settings-description">
      <div class="cookie-consent-panel-header">
        <h2 id="cookie-settings-title">Configurar cookies</h2>
        <button type="button" class="cookie-consent-close" data-cookie-close aria-label="Cerrar configuración">×</button>
      </div>
      <p id="cookie-settings-description">Elige qué categorías opcionales quieres permitir. Puedes cambiar de opinión cuando quieras.</p>
      <div class="cookie-category">
        <div>
          <h3>Cookies técnicas</h3>
          <p>Necesarias para el funcionamiento del sitio y para recordar preferencias de navegación.</p>
        </div>
        <span class="cookie-category-status">Siempre activas</span>
      </div>
      <label class="cookie-category cookie-category-toggle">
        <span>
          <strong>Analítica</strong>
          <span>Google Analytics 4 nos ayuda a medir el uso de forma anónima y agregada.</span>
        </span>
        <input type="checkbox" data-cookie-analytics />
      </label>
      <p class="cookie-consent-note">Al retirar el consentimiento, puede ser necesario borrar las cookies desde tu navegador.</p>
      <div class="cookie-consent-actions cookie-consent-dialog-actions">
        <button type="button" data-cookie-save>Guardar preferencias</button>
        <button type="button" data-cookie-close>Cancelar</button>
      </div>
    </section>
  </div>
</div>

<style>
  .cookie-consent {
    position: relative;
    z-index: 100;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .cookie-consent-banner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    max-width: 72rem;
    margin: auto;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--gray-500, #6474a2) 45%, transparent);
    border-radius: 0.75rem;
    background: var(--gray-999, #fff);
    color: var(--gray-0, #090b11);
    box-shadow: var(--shadow-lg, 0 8px 30px rgb(0 0 0 / 25%));
  }

  .cookie-consent h2,
  .cookie-consent h3,
  .cookie-consent p { margin: 0; }
  .cookie-consent h2 { font-size: 1.05rem; }
  .cookie-consent p { margin-top: 0.35rem; max-width: 52rem; font-size: 0.9rem; line-height: 1.45; }

  .cookie-consent-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .cookie-consent button { min-height: 2.5rem; padding: 0.55rem 0.85rem; border: 1px solid currentColor; border-radius: 0.4rem; background: transparent; color: inherit; font: inherit; cursor: pointer; }
  .cookie-consent button:focus-visible { outline: 3px solid var(--gold, var(--accent-light, #c561f6)); outline-offset: 2px; }
  .cookie-consent-actions button:first-child,
  .cookie-consent-dialog-actions button:first-child { border-color: var(--accent-regular, #7611a6); background: var(--accent-regular, #7611a6); color: var(--accent-text-over, #fff); }

  .cookie-settings-link { position: fixed; right: 1rem; bottom: 1rem; padding: 0.5rem 0.75rem; border-radius: 0.4rem; background: var(--gray-999, #fff); color: var(--gray-0, #090b11); box-shadow: var(--shadow-md, 0 4px 15px rgb(0 0 0 / 20%)); font-size: 0.85rem; }
  .cookie-consent-dialog[hidden], .cookie-consent-banner[hidden], .cookie-settings-link[hidden] { display: none; }
  .cookie-consent-dialog { position: fixed; inset: 0; display: grid; place-items: center; z-index: 101; padding: 1rem; }
  .cookie-consent-backdrop { position: absolute; inset: 0; background: rgb(0 0 0 / 65%); }
  .cookie-consent-panel { position: relative; width: min(100%, 34rem); padding: 1.25rem; border: 1px solid color-mix(in srgb, var(--gray-500, #6474a2) 45%, transparent); border-radius: 0.75rem; background: var(--gray-999, #fff); color: var(--gray-0, #090b11); box-shadow: var(--shadow-lg, 0 8px 30px rgb(0 0 0 / 30%)); }
  .cookie-consent-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .cookie-consent-close { border: 0 !important; font-size: 1.5rem !important; line-height: 1; }
  .cookie-category { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent); }
  .cookie-category p, .cookie-category span { display: block; font-size: 0.85rem; }
  .cookie-category-status { white-space: nowrap; font-weight: 600; }
  .cookie-category-toggle { cursor: pointer; }
  .cookie-category-toggle input { width: 1.25rem; height: 1.25rem; accent-color: var(--accent-regular, #7611a6); }
  .cookie-consent-note { margin-top: 1rem !important; font-size: 0.8rem !important; }
  .cookie-consent-dialog-actions { justify-content: flex-end; margin-top: 1.25rem; }

  @media (max-width: 700px) {
    .cookie-consent-banner { right: 0.5rem; bottom: 0.5rem; left: 0.5rem; display: block; max-height: min(70vh, 28rem); overflow: auto; padding: 0.9rem; }
    .cookie-consent-actions { margin-top: 0.75rem; }
    .cookie-consent-actions button { flex: 1 1 30%; padding-inline: 0.5rem; font-size: 0.85rem; }
    .cookie-settings-link { right: 0.5rem; bottom: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent *, .cookie-consent *::before, .cookie-consent *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; }
  }
</style>

<script is:inline>
  (() => {
    const storageKey = "cookie-consent-v1";
    const consentVersion = 1;
    const gaStateKey = "__cookieConsentGaLoaded";
    const defaultsSetKey = "__cookieConsentDefaultsSet";
    const getRoots = () => document.querySelectorAll("[data-cookie-consent]");

    const setAnalyticsConsent = (analytics) => {
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      if (!window[defaultsSetKey]) {
        window.gtag("consent", "default", { analytics_storage: "denied", ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", wait_for_update: 500 });
        window[defaultsSetKey] = true;
      }
      window.gtag("consent", "update", { analytics_storage: analytics ? "granted" : "denied" });
    };

    const loadAnalytics = (measurementId) => {
      if (!measurementId || window[gaStateKey]) return;
      setAnalyticsConsent(true);
      const script = document.createElement("script");
      script.id = "cookie-consent-google-analytics";
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
      document.head.appendChild(script);
      window.gtag("js", new Date());
      window.gtag("config", measurementId);
      window[gaStateKey] = true;
    };

    const readConsent = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || "null");
        return value && value.version === consentVersion && typeof value.analytics === "boolean" ? value : null;
      } catch { return null; }
    };

    const saveConsent = (analytics) => {
      try { localStorage.setItem(storageKey, JSON.stringify({ version: consentVersion, analytics })); } catch { return false; }
      return true;
    };

    const initialize = () => {
      const consent = readConsent();
      getRoots().forEach((root) => {
        if (root.dataset.cookieInitialized) return;
        root.dataset.cookieInitialized = "true";
        const banner = root.querySelector("[data-cookie-banner]");
        const dialog = root.querySelector("[data-cookie-dialog]");
        const settingsLink = root.querySelector("[data-cookie-settings]");
        const analyticsToggle = root.querySelector("[data-cookie-analytics]");
        let lastFocused;
        const close = () => { dialog.hidden = true; lastFocused?.focus(); };
        const open = () => { lastFocused = document.activeElement; analyticsToggle.checked = readConsent()?.analytics === true; dialog.hidden = false; analyticsToggle.focus(); };
        const apply = (analytics) => {
          if (!saveConsent(analytics)) { setAnalyticsConsent(false); return; }
          setAnalyticsConsent(analytics);
          if (analytics) loadAnalytics(root.dataset.measurementId);
          banner.hidden = true;
          settingsLink.hidden = false;
          close();
        };
        banner.hidden = Boolean(consent);
        settingsLink.hidden = !consent;
        root.querySelector("[data-cookie-accept]")?.addEventListener("click", () => apply(true));
        root.querySelector("[data-cookie-reject]")?.addEventListener("click", () => apply(false));
        root.querySelector("[data-cookie-open]")?.addEventListener("click", open);
        root.querySelector("[data-cookie-save]")?.addEventListener("click", () => apply(analyticsToggle.checked));
        root.querySelectorAll("[data-cookie-close]").forEach((button) => button.addEventListener("click", close));
        if (consent?.analytics) loadAnalytics(root.dataset.measurementId);
      });
      setAnalyticsConsent(consent?.analytics === true);
    };

    document.addEventListener("click", (event) => {
      const target = event.target.closest("[data-cookie-settings]");
      if (target) { event.preventDefault(); document.querySelector("[data-cookie-consent] [data-cookie-open]")?.click(); }
    });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") document.querySelector("[data-cookie-dialog]:not([hidden]) [data-cookie-close]")?.click(); });
    document.addEventListener("astro:page-load", initialize);
    document.addEventListener("astro:after-swap", initialize);
    initialize();
  })();
</script>
