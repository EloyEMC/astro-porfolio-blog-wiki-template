---
import Icon from "./Icon.astro";
import Search from "./Search.astro";
import { siteConfig } from "../config";

const navItems = [
  { href: "/", text: "Home" },
  { href: "/blog", text: "Blog" },
  { href: "/tags", text: "Tags" },
  { href: "/archive", text: "Archive" },
];
---

<header class="legacy-header">
  <div class="legacy-mobile-bar">
    <a href="/" class="legacy-brand legacy-brand-mobile">
      <Icon icon="terminal-window" />
      <span>{siteConfig.title}</span>
    </a>
    <button id="menu-button" class="legacy-menu-button" aria-label="Toggle Menu">
      <Icon icon="list" />
    </button>
  </div>

  <nav class="legacy-nav">
    <a href="/" class="legacy-brand legacy-brand-desktop">
      <Icon icon="terminal-window" />
      <span>{siteConfig.title}</span>
    </a>

    <div id="mobile-menu" class="legacy-mobile-menu hidden">
      <ul class="legacy-nav-list">
        {
          navItems.map(({ href, text }) => (
            <li>
              <a href={href}>{text}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="legacy-search">
      {siteConfig.search && <Search />}
    </div>
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById('menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  menuButton?.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
  });

  document.addEventListener('click', (event) => {
    if (
      !mobileMenu.contains(event.target) &&
      !menuButton.contains(event.target)
    ) {
      mobileMenu.classList.add('hidden');
    }
  });
</script>
