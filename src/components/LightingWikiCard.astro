---
import { LIGHTING_WIKI_CATEGORY_LABELS, lightingWikiUrl } from "../utils/lightingWiki";
import type { CollectionEntry } from "astro:content";

interface Props {
  term: CollectionEntry<"lightingWiki">;
}

const { term } = Astro.props;
const { title, category, shortDefinition, symbol } = term.data;
---

<article class="lighting-wiki-card" data-wiki-item data-search-text={[title, shortDefinition, category, ...(term.data.aliases ?? [])].join(" ").toLocaleLowerCase("es-ES")}>
  <p class="interior-eyebrow">{LIGHTING_WIKI_CATEGORY_LABELS[category]}</p>
  <h3><a href={lightingWikiUrl(term.id)}>{title}</a>{symbol && <span class="lighting-wiki-card-symbol">{symbol}</span>}</h3>
  <p>{shortDefinition}</p>
  <a class="lighting-wiki-card-link" href={lightingWikiUrl(term.id)}>Consultar término <span aria-hidden="true">→</span></a>
</article>
