<section class="newsletter-cta" aria-labelledby="newsletter-title">
  <div class="newsletter-cta-copy">
    <p class="editorial-eyebrow">Newsletter</p>
    <h2 id="newsletter-title">Iluminación, Tecnología y Negocio.</h2>
    <p>Ideas que iluminan decisiones y convierten proyectos en resultados.</p>
  </div>
  <form class="newsletter-cta-form" onsubmit="return false;">
    <label for="newsletter-email">Tu email</label>
    <div class="newsletter-cta-field">
      <input id="newsletter-email" name="email" type="email" placeholder="nombre@ejemplo.com" autocomplete="email" required />
      <button type="submit">Suscribirme</button>
    </div>
  </form>
</section>
