---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="post-recommendations random-posts" aria-labelledby="random-posts-title">
    <div class="post-recommendations-heading">
      <p class="editorial-eyebrow">Para explorar</p>
      <h2 id="random-posts-title">Más artículos</h2>
    </div>
    <ul class="random-posts-list">
      {posts.map((post) => (
        <li>
          <PostDate date={post.data.date} />
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          <span aria-hidden="true">↗</span>
        </li>
      ))}
    </ul>
  </section>
)}
