---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="post-recommendations related-posts" aria-labelledby="related-posts-title">
    <div class="post-recommendations-heading">
      <p class="editorial-eyebrow">Lecturas relacionadas</p>
      <h2 id="related-posts-title">También te puede interesar</h2>
    </div>
    <div class="related-posts-grid">
      {posts.map((post) => (
        <article class="related-post-card">
          {post.data.image && (
            <a class="related-post-image" href={`/blog/${post.slug}`} aria-label={`Leer ${post.data.title}`}>
              <img src={post.data.image} alt={post.data.image_alt || post.data.title} loading="lazy" decoding="async" />
            </a>
          )}
          <div class="related-post-card-content">
            <PostDate date={post.data.date} />
            <h3><a href={`/blog/${post.slug}`}>{post.data.title}</a></h3>
            {post.data.description && <p>{post.data.description}</p>}
            <a class="post-card-link" href={`/blog/${post.slug}`}>Leer artículo <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}
