---
import type { CollectionEntry } from "astro:content";
import { authors } from "../authors.js";
import { siteConfig } from "../config";
import { absoluteUrl, createSeoSchemas, normalizeUrl } from "../utils/seo";
import JsonLd from "./JsonLd.astro";

interface Props {
  entry: CollectionEntry<'blog'>;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
}

const { entry, siteUrl, defaultImage, defaultLocale = "es-ES" } = Astro.props;
const { data, id: slug } = entry;
const {
  title, seoTitle, description, category, date, modifiedDate, tags, image, image_alt,
  keywords, twitter_img, twitterCreator, twitterSite, author, authorUrl,
  authorImage, ogType = "article", siteName, noindex, nofollow, faqs, canonicalUrl,
} = data;
const authorData = author ? authors[author] : undefined;

const fullCanonicalUrl = normalizeUrl(siteUrl, canonicalUrl?.url || `/blog/${slug}/`);
const fullImageUrl = absoluteUrl(siteUrl, image || defaultImage);
const fullTwitterImageUrl = absoluteUrl(siteUrl, twitter_img || image || defaultImage);
const robotsContent = noindex
  ? "noindex, follow"
  : nofollow
    ? "nofollow"
    : "";
const schemaAuthor = authorData ? {
  name: authorData.name,
  url: authorUrl,
  image: authorImage ? absoluteUrl(siteUrl, authorImage) : authorData.image ? absoluteUrl(siteUrl, authorData.image) : undefined,
  bio: authorData.bio,
  sameAs: Object.values(authorData.social).filter((value): value is string => Boolean(value)),
} : author ? { name: author, url: authorUrl, image: authorImage ? absoluteUrl(siteUrl, authorImage) : undefined } : undefined;
const schemas = createSeoSchemas({
  siteUrl,
  title: seoTitle || title,
  description,
  canonicalUrl: fullCanonicalUrl,
  image: image || defaultImage,
  keywords,
  siteName: siteName || siteConfig.title,
  siteSameAs: Object.values(siteConfig.social).filter((value): value is string => typeof value === "string" && /^https?:\/\//i.test(value)),
  inLanguage: siteConfig.lang,
  logo: siteConfig.image,
  author: schemaAuthor,
  category,
  datePublished: date,
  dateModified: modifiedDate,
  article: ogType === "article",
  breadcrumbs: [
    { name: siteConfig.title, url: "/" },
    { name: "Artículos", url: "/articulos/" },
    { name: title, url: fullCanonicalUrl },
  ],
  faqs,
});
---

<title>{seoTitle || title}</title>
{description && <meta name="description" content={description} />}
{keywords?.length && <meta name="keywords" content={keywords.join(", ")} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={seoTitle || title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={fullImageUrl} />
{image_alt && <meta property="og:image:alt" content={image_alt} />}
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={defaultLocale} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={seoTitle || title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={fullTwitterImageUrl} />
{image_alt && <meta name="twitter:image:alt" content={image_alt} />}
<link rel="canonical" href={fullCanonicalUrl} />
{author && <meta name="author" content={authorData?.name || author} />}
{authorUrl && <link rel="author" href={authorUrl} />}
{authorImage && <meta name="author-image" content={absoluteUrl(siteUrl, authorImage)} />}
<meta property="article:published_time" content={date.toISOString()} />
{modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<JsonLd schemas={schemas} />
<link rel="alternate" type="application/rss+xml" title="RSS de Eloy Martínez Cuesta" href="/rss.xml" />
<link rel="icon" type="image/png" href="/favicon-emc-512.png?v=4" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-emc-32.png?v=4" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-emc-16.png?v=4" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-emc-v4.png?v=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
