---
import { absoluteUrl } from "../utils/seo";

interface Props {
  title: string;
  description?: string;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
  image?: string;
  image_alt?: string;
  keywords?: string[];
  twitter_img?: string;
  twitterCreator?: string;
  twitterSite?: string;
  ogType?: string;
  siteName?: string;
  noindex?: boolean;
  nofollow?: boolean;
  faqs?: { question: string; answer: string }[];
  author?: string;
  authorUrl?: string;
  authorImage?: string;
  date?: Date;
  modifiedDate?: string;
  tags?: string[];
  slug?: string;
  canonical?: boolean;
}

const {
  title, description, siteUrl, defaultImage, defaultLocale = "es_ES",
  image, image_alt, keywords, twitter_img, twitterCreator, twitterSite,
  ogType = "website", siteName, noindex, nofollow, faqs, author, authorUrl,
  authorImage, date, modifiedDate, tags, slug, canonical = true,
} = Astro.props;

const normalizedSiteUrl = siteUrl.replace(/\/+$/, '');
const normalizedSlug = (slug || '').replace(/^\/+|\/+$/g, '');
const fullCanonicalUrl = `${normalizedSiteUrl}${normalizedSlug ? `/${normalizedSlug}` : ''}/`;
const fullImageUrl = absoluteUrl(siteUrl, image || defaultImage);
const fullTwitterImageUrl = absoluteUrl(siteUrl, twitter_img || fullImageUrl);

const metaRobots: string[] = [];
if (noindex) metaRobots.push('noindex');
if (nofollow) metaRobots.push('nofollow');
const robotsContent = metaRobots.join(', ');

const schemaOrgJSON = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "BlogPosting" : "WebPage",
  "headline": title,
  "description": description || "Default description",
  "url": fullCanonicalUrl,
  "image": fullImageUrl,
  "keywords": keywords?.join(', ') || "",
  "mainEntityOfPage": { "@type": "WebPage", "@id": fullCanonicalUrl },
  ...(ogType === "article" && {
    "datePublished": date?.toISOString(),
    "dateModified": modifiedDate || date?.toISOString(),
    "author": {
      "@type": "Person",
      "name": author || "Unknown Author",
      "url": authorUrl || siteUrl,
      "image": authorImage ? `${siteUrl}${authorImage}` : undefined,
    },
  }),
  "publisher": {
    "@type": "Organization",
    "name": siteName || "Eloy Martínez Cuesta",
    "logo": {
      "@type": "ImageObject",
      "url": `${normalizedSiteUrl}/logo-eloy-martinez-cuesta-marketing-digital-blanco.png`,
      "width": 600,
      "height": 60,
    },
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": title, "item": fullCanonicalUrl },
    ],
  },
  "isPartOf": {
    "@type": "WebSite",
    "name": siteName || "Eloy Martínez Cuesta",
    "url": siteUrl,
    "description": description || "Default description",
  },
};

const faqJSON = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
  })),
} : null;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={fullImageUrl} />
{image_alt && <meta property="og:image:alt" content={image_alt} />}
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={defaultLocale} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={fullTwitterImageUrl} />
{image_alt && <meta name="twitter:image:alt" content={image_alt} />}
{canonical && <link rel="canonical" href={fullCanonicalUrl} />}
{author && ogType === "article" && <meta name="author" content={author} />}
{authorUrl && ogType === "article" && <link rel="author" href={authorUrl} />}
{authorImage && ogType === "article" && <meta name="author-image" content={`${siteUrl}${authorImage}`} />}
{ogType === "article" && date && <meta property="article:published_time" content={date.toISOString()} />}
{ogType === "article" && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{tags && tags.length > 0 && ogType === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<script type="application/ld+json" set:html={` ${JSON.stringify(schemaOrgJSON)} `}></script>
{faqJSON && <script type="application/ld+json" set:html={` ${JSON.stringify(faqJSON)} `}></script>}
<link rel="icon" type="image/png" href="/favicon-emc-512.png?v=4" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-emc-32.png?v=4" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-emc-16.png?v=4" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-emc-v4.png?v=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="UA-45788975-1" />
