---
// src/components/SEO.astro
interface Props {
  title: string;
  description?: string;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
  image?: string;
  image_alt?: string;
  keywords?: string[];
  twitter_img?: string;
  twitterCreator?: string;
  twitterSite?: string;
  ogType?: string;
  siteName?: string;
  noindex?: boolean;
  nofollow?: boolean;
  faqs?: { question: string; answer: string }[];
  author?: string;
  authorUrl?: string;
  authorImage?: string;
  date?: Date;
  modifiedDate?: string;
  tags?: string[];
  slug: string;
 
}

const {
  title,
  description,
  siteUrl,
  defaultImage,
  defaultLocale = "es_ES",
  image,
  image_alt,
  keywords,
  twitter_img,
  twitterCreator,
  twitterSite,
  ogType = "website",
  siteName,
  noindex,
  nofollow,
  faqs,
  author,
  authorUrl,
  authorImage,
  date,
  modifiedDate,
  tags,
  slug,
  
} = Astro.props;

// Generar la URL canónica
const fullCanonicalUrl = `${siteUrl}/${slug}/`;

// Generar la URL completa de la imagen
const fullImageUrl = image ? `${siteUrl}${image}` : defaultImage;
const fullTwitterImageUrl = twitter_img ? `${siteUrl}${twitter_img}` : fullImageUrl;

// Meta robots
const metaRobots: string[] = [];
if (noindex) metaRobots.push('noindex');
if (nofollow) metaRobots.push('nofollow');
const robotsContent = metaRobots.join(', ');

// Schema.org (JSON-LD)
const schemaOrgJSON = {
  "@context": "https://schema.org",
  "@type": ogType === "article" ? "BlogPosting" : "WebPage",
  "headline": title,
  "description": description || "Default description",
  "url": fullCanonicalUrl,
  "image": fullImageUrl,
  "keywords": keywords?.join(', ') || "",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": fullCanonicalUrl,
  },
  ...(ogType === "article" && {
    "datePublished": date?.toISOString(),
    "dateModified": modifiedDate || date?.toISOString(),
    "author": {
      "@type": "Person",
      "name": author || "Unknown Author",
      "url": authorUrl || siteUrl,
      "image": authorImage ? `${siteUrl}${authorImage}` : undefined,
    },
    "publisher": {
      "@type": "Organization",
      "name": siteName || "Default Site Name",
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/public/logo-eloy-martinez-cuesta-marketing-digital-blanco.png`,
      },
    },
  }),
  // Mejoras adicionales
  "publisher": {
    "@type": "Organization",
    "name": siteName || "Eloy Martínez Cuesta",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/logo.png`,
      "width": 600,
      "height": 60,
    },
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl,
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": title,
        "item": fullCanonicalUrl,
      },
    ],
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
  "isPartOf": {
    "@type": "WebSite",
    "name": siteName || "Eloy Martínez Cuesta",
    "url": siteUrl,
    "description": description || "Default description",
  },
  ...(author && {
    "author": {
      "@type": "Person",
      "name": author,
      "url": authorUrl || siteUrl,
      "sameAs": [
        `https://twitter.com/${twitterCreator}`,
         "https://www.linkedin.com/in/eloymartinezemc/",
        "https://github.com/EloyEMC", 
      ],
    },
  }),
};

// BreadcrumbList
const breadcrumbListJSON = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl,
    },
  ],
};

// Schema.org (JSON-LD) para FAQs
const faqJSON = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
} : null;
---

<!-- Title -->
<title>{title}</title>

<!-- Description -->
{description && <meta name="description" content={description} />}

<!-- Keywords -->
{keywords && keywords.length > 0 && (
  <meta name="keywords" content={keywords.join(', ')} />
)}

<!-- Robots -->
{robotsContent && <meta name="robots" content={robotsContent} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={fullImageUrl} />
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={defaultLocale} />
<meta property="og:url" content={fullCanonicalUrl} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={fullTwitterImageUrl} />

<!-- Canonical URL -->
<link rel="canonical" href={fullCanonicalUrl} />

<!-- Autor (solo para entradas de blog) -->
{author && ogType === "article" && <meta name="author" content={author} />}
{authorUrl && ogType === "article" && <link rel="author" href={authorUrl} />}
{authorImage && ogType === "article" && <meta name="author-image" content={`${siteUrl}${authorImage}`} />}

<!-- Fecha (solo para entradas de blog) -->
{ogType === "article" && date && (
  <>
    <meta property="article:published_time" content={date.toISOString()} />
    {modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate} />
    )}
  </>
)}

<!-- Etiquetas (solo para entradas de blog) -->
{tags && tags.length > 0 && ogType === "article" && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Schema.org (JSON-LD) -->
<script type="application/ld+json" set:html={` ${JSON.stringify(schemaOrgJSON)} `}></script>
<!-- BreadcrumbList (JSON-LD) -->
<script type="application/ld+json" set:html={` ${JSON.stringify(breadcrumbListJSON)} `}></script>
<!-- FAQs (JSON-LD) -->
{faqJSON && (
  <script type="application/ld+json" set:html={` ${JSON.stringify(faqJSON)} `}></script>
)}

<!-- Favicon (opcional) -->
<link rel="icon" type="image/png" href={`${siteUrl}/favicon.png`} />

<!-- Theme Color (opcional) -->
<meta name="theme-color" content="#ffffff" />

<!-- Viewport (opcional) -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="UA-45788975-1" />