---
import { siteConfig } from "../config";
import { absoluteUrl, createSeoSchemas, normalizeUrl } from "../utils/seo";
import JsonLd from "./JsonLd.astro";

interface Props {
  title: string;
  description?: string;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
  image?: string;
  image_alt?: string;
  keywords?: string[];
  twitter_img?: string;
  twitterCreator?: string;
  twitterSite?: string;
  ogType?: string;
  siteName?: string;
  noindex?: boolean;
  nofollow?: boolean;
  faqs?: { question: string; answer: string }[];
  author?: string;
  authorUrl?: string;
  authorImage?: string;
  date?: Date;
  modifiedDate?: string;
  tags?: string[];
  slug?: string;
  canonicalUrl?: string;
  canonical?: boolean;
}

const {
  title, description, siteUrl, defaultImage, defaultLocale = "es_ES", image, image_alt,
  keywords, twitter_img, twitterCreator, twitterSite, ogType = "website", siteName,
  noindex, nofollow, faqs, author, authorUrl, authorImage, date, modifiedDate, tags,
  slug, canonicalUrl, canonical = true,
} = Astro.props;
const fullCanonicalUrl = normalizeUrl(siteUrl, canonicalUrl || `/${(slug || "").replace(/^\/+|\/+$/g, "")}`);
const fullImageUrl = absoluteUrl(siteUrl, image || defaultImage);
const fullTwitterImageUrl = absoluteUrl(siteUrl, twitter_img || image || defaultImage);
const robotsContent = noindex
  ? "noindex, follow"
  : nofollow
    ? "nofollow"
    : "";
const schemas = createSeoSchemas({
  siteUrl,
  title,
  description,
  canonicalUrl: fullCanonicalUrl,
  image: image || defaultImage,
  keywords,
  siteName: siteName || siteConfig.title,
  siteSameAs: Object.values(siteConfig.social).filter((value): value is string => typeof value === "string" && /^https?:\/\//i.test(value)),
  inLanguage: siteConfig.lang,
  logo: siteConfig.image,
  author: author ? { name: author, url: authorUrl, image: authorImage ? absoluteUrl(siteUrl, authorImage) : undefined } : undefined,
  datePublished: date,
  dateModified: modifiedDate,
  article: ogType === "article",
  breadcrumbs: [{ name: siteConfig.title, url: "/" }, { name: title, url: fullCanonicalUrl }],
  faqs,
});
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{keywords?.length && <meta name="keywords" content={keywords.join(", ")} />}
{robotsContent && <meta name="robots" content={robotsContent} />}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={fullImageUrl} />
{image_alt && <meta property="og:image:alt" content={image_alt} />}
{siteName && <meta property="og:site_name" content={siteName} />}
<meta property="og:locale" content={defaultLocale} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
{twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={fullTwitterImageUrl} />
{image_alt && <meta name="twitter:image:alt" content={image_alt} />}
{canonical && <link rel="canonical" href={fullCanonicalUrl} />}
{author && ogType === "article" && <meta name="author" content={author} />}
{authorUrl && ogType === "article" && <link rel="author" href={authorUrl} />}
{authorImage && ogType === "article" && <meta name="author-image" content={absoluteUrl(siteUrl, authorImage)} />}
{ogType === "article" && date && <meta property="article:published_time" content={date.toISOString()} />}
{ogType === "article" && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
{ogType === "article" && tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<JsonLd schemas={schemas} />
<link rel="icon" type="image/png" href="/favicon-emc-512.png?v=4" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-emc-32.png?v=4" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-emc-16.png?v=4" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-emc-v4.png?v=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="google-site-verification" content="UA-45788975-1" />
