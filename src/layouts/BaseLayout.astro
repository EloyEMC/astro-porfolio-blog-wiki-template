---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, slide } from 'astro:transitions';
import { GoogleAnalytics } from 'astro-google-analytics';
import { siteConfig } from '../config';
import SEOPage from '@components/SEOPage.astro';

interface Props {
  title?: string; // Título opcional
  author?: string; // Autor opcional
  defaultImage?: string;
  siteUrl?: string;
}

// Definir las constantes para el SEO
const { title = "Eloy Martínez Cuesta" } = Astro.props;
const description = "La web de Eloy Martínez Cuesta, donde encontrarás novedades IA, iluminación, marketing, SEO, dev...";
const slug = "";
const defaultLocale = "es_ES";
const { author } = Astro.props;
const authorData = author || null;

// Obtener siteUrl y defaultImage directamente de siteConfig
const siteUrl = siteConfig.site;
const defaultImage = siteConfig.image || "ruta/a/imagen-por-defecto.jpg"; // Valor por defecto
---

<!doctype html> 
<html lang="es" class="dark">
  <head>
    <!-- Componente SEO -->
    <SEOPage
      title={title}
      description={description}
      siteUrl={siteUrl}
      defaultImage={defaultImage}
      slug={slug}
    />

    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <title>{title || "Eloy Martínez Cuesta"}</title>
    <link rel="icon" type="image/svg+xml" href="eloy-ico.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-white dark:bg-gray-900">
    <Header transition:persist />
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <main class="py-12" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>
    </div>
    <Footer transition:persist />
  </body>
</html>
