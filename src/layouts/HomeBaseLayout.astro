---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter, slide } from 'astro:transitions'
import { GoogleAnalytics } from 'astro-google-analytics'
import { siteConfig } from '../config'
import SEOPage from '@components/SEOPage.astro'

const title = "Eloy Martínez Cuesta";
const description = "La web de Eloy Martínez Cuesta, donde encontrarás novedades IA, iluminación, marketing, SEO, dev...";
const siteUrl = "https://eloymartínezcuesta.com";
const defaultImage = "/Eloy-martinez-cuesta-web.webp";
const slug = "about";
 
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <SEOPage
      title={title}
      description={description}
      siteUrl={siteUrl}
      defaultImage={defaultImage}
      slug={slug}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="./public/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
    <ClientRouter />
  </head>
  <body class="absolute top-0 z-[-2] h-screen w-screen bg-white dark:bg-gray-900">
    <div class="">
      <Header transition:persist />
      <main class="py-4" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>
      <Footer transition:persist />
    </div>
  </body>
</html>

