---
import { ClientRouter } from 'astro:transitions';
import { GoogleAnalytics } from 'astro-google-analytics';
import { siteConfig } from '../config';
import SEOPage from '@components/SEOPage.astro';

import '../styles/global.css';
import '../styles/redesign.css';

interface Props { siteUrl: string; defaultImage?: string; title?: string; }
const { siteUrl, title = 'Eloy Martínez Cuesta' } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <SEOPage title={title} description={siteConfig.description} siteUrl={siteUrl} defaultImage={siteConfig.image || ''} image_alt={siteConfig.image_alt} slug="" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-emc-512.png?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-emc-32.png?v=4" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-emc-16.png?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-emc-v4.png?v=1" />
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
    <ClientRouter />
  </head>
      <body>
        <main><slot /></main>
      </body>
</html>
