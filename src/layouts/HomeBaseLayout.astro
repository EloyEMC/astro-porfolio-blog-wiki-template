---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter, slide } from 'astro:transitions';
import { GoogleAnalytics } from 'astro-google-analytics';
import { siteConfig } from '../config';
import SEOPage from '@components/SEOPage.astro';

interface Props {
  site?: string;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
  author?: string;
  
}

// Definir las constantes para el SEO
const title = "Eloy Martínez Cuesta";
const description = "La web de Eloy Martínez Cuesta, donde encontrarás novedades IA, iluminación, marketing, SEO, dev...";
const slug = "";
const { siteUrl, defaultImage, defaultLocale = "es_ES", } = Astro.props;
const { author } = Astro.props;
const authorData = author || null;

---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <!-- Componente SEO -->
    <SEOPage
      title={title}
      description={description}
      siteUrl={siteUrl}
      defaultImage={defaultImage}
      slug={slug}
      
    />

    <!-- Metadatos básicos -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Analytics (si está configurado) -->
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}

    <!-- ClientRouter para transiciones -->
    <ClientRouter />
  </head>
  <body class="absolute top-0 z-[-2] h-screen w-screen bg-white dark:bg-gray-900">
    <div class="">
      <!-- Header con persistencia -->
      <Header transition:persist />

      <!-- Contenido principal con animación de slide -->
      <main class="py-4" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>

      <!-- Footer con persistencia -->
      <Footer transition:persist />
    </div>
  </body>
</html>