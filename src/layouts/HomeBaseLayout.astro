---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter, slide } from 'astro:transitions'
import { GoogleAnalytics } from 'astro-google-analytics'
import { siteConfig } from '../config'

interface Props {
  title: string
  description?: string
  lang?: string
}

const { title, description = 'A minimal blog focused on excellent reading experience', lang } = Astro.props
---

<!doctype html>
<html lang={siteConfig.lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.webp" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
    <ClientRouter />
  </head>
  <body class="absolute top-0 z-[-2] h-screen w-screen bg-white dark:bg-gray-900">
    <div class="">
      <Header transition:persist />
      <main class="py-4" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>
      <Footer transition:persist />
    </div>
  </body>
</html>

