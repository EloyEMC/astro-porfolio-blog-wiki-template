---
import { ClientRouter } from 'astro:transitions';
import CookieConsent from '../components/CookieConsent.astro';
import { siteConfig, type SeoPerson } from '../config';
import SEOPage from '@components/SEOPage.astro';

import '../styles/global.css';
import '../styles/redesign.css';

interface Props { siteUrl: string; defaultImage?: string; title?: string; description?: string; person?: SeoPerson; }
const { siteUrl, title = 'Generic Author', description = siteConfig.description, person } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <SEOPage title={title} description={description} siteUrl={siteUrl} defaultImage={siteConfig.defaultImage || siteConfig.image || ''} image_alt={siteConfig.image_alt} slug="" person={person} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/abstract-card.svg" media="(max-width: 800px)" as="image" fetchpriority="high" />
    <link rel="preload" href="/abstract-card.svg" media="(min-width: 801px)" as="image" fetchpriority="high" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
    <ClientRouter />
  </head>
      <body>
        <main><slot /></main>
        <CookieConsent measurementId={siteConfig.googleAnalysis} />
      </body>
</html>
