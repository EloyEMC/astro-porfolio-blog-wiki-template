---
import { ClientRouter, slide } from "astro:transitions";
import CookieConsent from "../components/CookieConsent.astro";
import { siteConfig } from "../config";
import SEO from "../components/SEO.astro";
import Sidebar from "../components/Sidebar.astro";
import ContentNav from "../components/ContentNav.astro";
import { type CollectionEntry } from 'astro:content';
import "../styles/global.css";
import "../styles/redesign.css";

interface Props {
  entry: CollectionEntry<'blog'>;
  siteUrl: string;
  defaultImage: string;
  defaultLocale?: string;
  author?: string;
}

const { entry, siteUrl, defaultImage, defaultLocale = "es_ES" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <SEO entry={entry} siteUrl={siteUrl} defaultImage={defaultImage} defaultLocale={defaultLocale} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />
  </head>
<body class="interior-shell article-shell">
  <div id="_drawer" class="interior-drawer">
    <Sidebar />
    <div class="interior-main">
      <ContentNav />
      <main class="interior-content" transition:animate={slide({ duration: ".3s" })}>
        <slot />
      </main>
        </div>
      </div>
      <CookieConsent measurementId={siteConfig.googleAnalysis} />
    </body>
    </html>
