---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404 Not Found" noindex canonical={false}>
<div class="editorial-error">
    <h1 class="editorial-error-code">404</h1>
    <p class="editorial-error-title">Oops! Page not found</p>
    <p class="editorial-error-copy">
      The page you're looking for doesn't exist or has been moved.
    </p>

    <a 
      href="/" 
      class="editorial-button"
    >
      Return Home
    </a>
  </div>
</BaseLayout> 
