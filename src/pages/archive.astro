---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { filterPublishedPosts, sortPostsByDate } from '../utils/posts';
import PostDate from '../components/PostDate.astro';
import { siteConfig } from '../config.ts'; // Importar la configuración del sitio

interface Props {
  siteUrl: string;         // URL del sitio (obligatorio)
  defaultImage: string;    // Imagen por defecto (obligatorio)
  title?: string;         // Título (opcional)
}

const posts = await getCollection('blog');
const publishedPosts = filterPublishedPosts(posts);
const sortedPosts = sortPostsByDate(publishedPosts);

// Agrupar posts por año 
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof sortedPosts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  siteUrl={siteConfig.site} 
  defaultImage={siteConfig.image} 
  title="Archive"
  slug="archive"
>
<h1 class="editorial-page-title">Archive</h1>

  {years.map(year => (
    <section class="editorial-archive-year">
      <h2 class="editorial-section-title">{year}</h2>
      <ul class="editorial-archive-list">
        {postsByYear[year].map(post => (
<li class="editorial-archive-item">
            <span class="editorial-archive-date">
              <PostDate date={post.data.date} />
            </span>
            <a 
              href={`/blog/${post.slug}`}
              class="editorial-archive-link"
            >
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
