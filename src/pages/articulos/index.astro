---
import { getCollection } from "astro:content";
import InteriorLayout from "../../layouts/InteriorLayout.astro";
import { siteConfig } from "../../config";
import { filterPublishedPosts, sortPostsByDate } from "../../utils/posts";
import { publications } from "../../data/publications";

const posts = sortPostsByDate(filterPublishedPosts(await getCollection("blog")));
const featuredTitles = new Set([
  "¿Qué es la temperatura de color?",
  "¿Qué es realmente la luz?",
  "Cómo Personalizar la Página de Categorías en WordPress",
]);
const featuredPosts = posts.filter((post) => featuredTitles.has(post.data.title)).slice(0, 4);
const categories = ["Iluminación", "Tecnología", "Negocio", "Conocimiento"];

function categoryForPost(post: (typeof posts)[number]) {
  return post.data.category;
}

function searchText(post: (typeof posts)[number]) {
  return [
    post.data.title,
    post.data.description,
    post.data.category,
    ...(post.data.tags ?? []),
    post.body ?? "",
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
}

const availableCategories = categories.filter((category) => posts.some((post) => categoryForPost(post) === category));
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Artículos sobre iluminación, tecnología y negocio | Eloy Martínez Cuesta",
  description: "Artículos de Eloy Martínez Cuesta sobre iluminación profesional, tecnología aplicada, software, proyectos y negocio, junto a publicaciones en medios especializados.",
  url: `${siteConfig.site}/articulos/`,
  inLanguage: "es-ES",
  about: { "@type": "Person", name: "Eloy Martínez Cuesta", url: siteConfig.site },
};
---

<InteriorLayout
  title="Artículos sobre iluminación, tecnología y negocio | Eloy Martínez Cuesta"
  description="Artículos y publicaciones de Eloy Martínez Cuesta sobre iluminación profesional, tecnología, software y negocio: conocimiento nacido de la experiencia y de problemas reales."
  slug="articulos"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)}></script>

  <section class="articles-page" aria-labelledby="articles-title">
    <header class="articles-hero">
      <div class="articles-hero-copy">
        <p class="interior-eyebrow">04 / ARTÍCULOS</p>
        <h1 id="articles-title">Artículos.</h1>
        <p class="articles-hero-lede">Conocimiento para aplicar.</p>
        <p class="articles-hero-description">Ideas, análisis y aprendizajes sobre iluminación, tecnología y negocio.</p>
        <p class="articles-editorial-paragraph">No escribo para acumular publicaciones. Escribo para ordenar lo aprendido, profundizar en los problemas y compartir aquello que puede resultar útil a otros.</p>
      </div>
      <img class="articles-hero-image" src="/articles/articles-hero.webp" alt="Escritorio de trabajo con libros, planos, una lámpara y una cámara" width="1672" height="941" loading="eager" decoding="async" />
    </header>

    {featuredPosts.length > 0 && (
      <section class="articles-featured editorial-section" aria-labelledby="featured-title">
        <div class="articles-section-heading">
          <div>
            <p class="interior-eyebrow">DESTACADOS</p>
            <h2 id="featured-title">Algunas ideas merecen más espacio.</h2>
          </div>
          <p class="articles-section-note">Una selección de artículos sobre iluminación profesional, tecnología aplicada, proyectos y negocio.</p>
        </div>
        <div class="featured-grid">
          {featuredPosts.map((post) => (
            <article class="featured-article">
              {post.data.image && (
                <a class="featured-article-image" href={`/blog/${post.id}/`}>
                  <img src={post.data.image} alt={post.data.image_alt || post.data.title} width="900" height="560" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="featured-article-copy">
                <p class="interior-eyebrow">{categoryForPost(post)} · {post.data.date.toLocaleDateString("es-ES", { year: "numeric", month: "long" })}</p>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.description && <p>{post.data.description}</p>}
                <a class="articles-cta" href={`/blog/${post.id}/`}>Leer artículo <span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="articles-publications-section editorial-section" aria-labelledby="publications-title">
      <div class="articles-section-heading">
        <div>
          <p class="interior-eyebrow">PUBLICACIONES EN MEDIOS</p>
          <h2 id="publications-title">Algunas ideas también salen de aquí.</h2>
        </div>
        <p class="articles-section-note">Además de lo que publico en esta web, ocasionalmente colaboro con medios profesionales compartiendo conocimiento y experiencia sobre iluminación.</p>
      </div>
      <div class="articles-publications">
        {publications.map((publication) => (
          <article class="publication-spread">
            <a class="publication-image-link" href={publication.url} target="_blank" rel="noopener noreferrer">
              <img src={publication.image} alt={publication.alt} width="670" height="949" loading="lazy" decoding="async" />
            </a>
            <div class="publication-copy">
              <p class="interior-eyebrow">{publication.publication} · {publication.date}</p>
              <h3><a href={publication.url} target="_blank" rel="noopener noreferrer">{publication.title}</a></h3>
              <ul class="publication-topics" aria-label={`Temas de ${publication.title}`}>
                {publication.topics.map((topic) => <li>{topic}</li>)}
              </ul>
              <p>{publication.description}</p>
              <p class="publication-byline">{publication.author}<br />{publication.role}</p>
              <a class="articles-cta" href={publication.url} target="_blank" rel="noopener noreferrer">Leer en Revista AÚNA <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="articles-themes editorial-section" aria-labelledby="themes-title">
      <div class="articles-section-heading">
        <div>
          <p class="interior-eyebrow">TEMAS</p>
          <h2 id="themes-title">Iluminación. Tecnología. Negocio.</h2>
        </div>
        <p class="articles-section-note">Tres ámbitos que muchas veces terminan hablando de lo mismo: entender mejor un problema para poder tomar mejores decisiones.</p>
      </div>
      <div class="theme-list">
        <a class="theme-link" href="/iluminacion/">
          <span class="theme-number">01</span>
          <span><strong>ILUMINACIÓN</strong><small>Diseño, producto, fotometría, control, eficiencia, normativa y experiencia de proyecto.</small></span>
          <span class="theme-arrow" aria-hidden="true">→</span>
        </a>
        <a class="theme-link" href="/tecnologia/">
          <span class="theme-number">02</span>
          <span><strong>TECNOLOGÍA</strong><small>Software, programación, automatización, inteligencia artificial, datos y herramientas.</small></span>
          <span class="theme-arrow" aria-hidden="true">→</span>
        </a>
        <a class="theme-link" href="/proyectos/">
          <span class="theme-number">03</span>
          <span><strong>NEGOCIO</strong><small>Producto, distribución, clientes, mercado, servicio y desarrollo de soluciones.</small></span>
          <span class="theme-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="articles-archive editorial-section" aria-labelledby="archive-title">
      <div class="articles-section-heading articles-archive-heading">
        <div>
          <p class="interior-eyebrow">ARCHIVO</p>
          <h2 id="archive-title">Todo lo publicado.</h2>
        </div>
        <label class="articles-search">
          <span>Buscar en artículos</span>
          <input type="search" data-articles-search placeholder="Título, tema o palabra" autocomplete="off" />
        </label>
      </div>

      <div class="articles-filters" role="group" aria-label="Filtrar artículos por categoría">
        <button type="button" class="is-active" data-category-filter="all">Todos</button>
        {availableCategories.map((category) => <button type="button" data-category-filter={category}>{category}</button>)}
      </div>

      <div class="articles-list" data-articles-list>
        {posts.map((post) => {
          const category = categoryForPost(post);
          const tags = post.data.tags ?? [];
          return (
            <article class="articles-list-item" data-article-item data-category={category} data-search-text={searchText(post)}>
              <div class="articles-list-meta">
                <p class="interior-eyebrow">{post.data.date.toLocaleDateString("es-ES", { year: "numeric", month: "long" })}</p>
                <span>{category}</span>
              </div>
              <div class="articles-list-copy">
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.description && <p>{post.data.description}</p>}
                {tags.length > 0 && <p class="articles-tags">{tags.join(" · ")}</p>}
              </div>
              <a class="articles-list-arrow" href={`/blog/${post.id}/`} aria-label={`Leer ${post.data.title}`}><span aria-hidden="true">↗</span></a>
            </article>
          );
        })}
      </div>
      <p class="articles-empty" data-articles-empty hidden>No hay artículos que coincidan con esta búsqueda.</p>
    </section>

    <section class="articles-closing editorial-section" aria-labelledby="closing-title">
      <p class="interior-eyebrow">SEGUIR APRENDIENDO</p>
      <h2 id="closing-title">Una cosa lleva a la otra.</h2>
      <div class="articles-closing-copy">
        <p>Un artículo lleva a otro problema.</p>
        <p>Un problema lleva a investigar.</p>
        <p>Y algunas veces esa investigación termina convirtiéndose en una herramienta.</p>
      </div>
      <div class="articles-closing-actions">
        <a class="articles-cta" href="/proyectos/">VER PROYECTOS <span aria-hidden="true">→</span></a>
        <a class="articles-cta" href="/tecnologia/">TECNOLOGÍA APLICADA <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </section>
</InteriorLayout>

<script>
  const initializeArticles = () => {
    const search = document.querySelector<HTMLInputElement>("[data-articles-search]");
    if (!search || search.dataset.initialized === "true") return;

    search.dataset.initialized = "true";
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]")];
    const items = [...document.querySelectorAll<HTMLElement>("[data-article-item]")];
    const empty = document.querySelector<HTMLElement>("[data-articles-empty]");
    let selectedCategory = "all";

    const updateArticles = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const matchesCategory = selectedCategory === "all" || item.dataset.category === selectedCategory;
        const matchesSearch = !query || (item.dataset.searchText ?? "").includes(query);
        const isVisible = matchesCategory && matchesSearch;
        item.hidden = !isVisible;
        if (isVisible) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
    };

    search.addEventListener("input", updateArticles);
    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        selectedCategory = button.dataset.categoryFilter ?? "all";
        filterButtons.forEach((candidate) => candidate.classList.toggle("is-active", candidate === button));
        updateArticles();
      });
    });
  };

  initializeArticles();
  document.addEventListener("astro:page-load", initializeArticles);
</script>

<style>
  .articles-page { max-width: 78rem; }
  .articles-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.8fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .articles-hero-copy { max-width: 43rem; padding: 2rem 0; }
  .articles-hero h1 { margin: 1rem 0 0.5rem; color: var(--paper); font-size: clamp(3.5rem, 9vw, 7rem); letter-spacing: -0.07em; line-height: 0.88; }
  .articles-hero-lede { margin: 0; color: var(--paper); font-size: clamp(1.5rem, 3vw, 2.6rem); letter-spacing: -0.04em; }
  .articles-hero-description { max-width: 34rem; margin: 1.5rem 0 0; color: var(--paper); font-size: 1.15rem; line-height: 1.45; }
  .articles-editorial-paragraph { max-width: 38rem; margin: 2rem 0 0; color: var(--muted-ink); line-height: 1.7; }
  .articles-hero-image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center; }
  .editorial-section { margin-top: clamp(5rem, 9vw, 9rem); }
  .articles-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.5rem; }
  .articles-section-heading h2 { max-width: 46rem; margin: 0.75rem 0 0; color: var(--paper); }
  .articles-section-note { max-width: 22rem; margin: 0; color: var(--muted-ink); line-height: 1.6; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .featured-article { display: flex; flex-direction: column; border-top: 1px solid var(--section-line); padding-top: 1rem; }
  .featured-article-image { display: block; aspect-ratio: 16 / 10; overflow: hidden; }
  .featured-article-image img { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.8); transition: opacity 0.25s ease; }
  .featured-article-image:hover img { opacity: 0.78; }
  .featured-article-copy { display: flex; flex: 1; flex-direction: column; }
  .featured-article-copy h3 { margin: 0.7rem 0; color: var(--paper); font-size: clamp(1.35rem, 2vw, 2rem); line-height: 1.08; }
  .featured-article-copy h3 a { color: inherit; text-decoration: none; }
  .featured-article-copy h3 a:hover { color: var(--gold); }
  .featured-article-copy > p:not(.interior-eyebrow) { margin: 0; color: var(--muted-ink); line-height: 1.6; }
  .featured-article-copy .articles-cta { margin-top: auto; }
  .articles-publications { display: grid; gap: clamp(3.5rem, 7vw, 7rem); }
  .publication-spread { display: grid; grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; border-top: 1px solid var(--section-line); padding-top: 2rem; }
  .publication-spread:nth-child(even) { grid-template-columns: minmax(0, 1.3fr) minmax(13rem, 0.7fr); }
  .publication-spread:nth-child(even) .publication-image-link { order: 2; }
  .publication-image-link { display: block; background: #f7f7f4; transition: opacity 0.25s ease; }
  .publication-image-link:hover { opacity: 0.78; }
  .publication-image-link img { display: block; width: 100%; height: auto; max-height: 35rem; object-fit: contain; }
  .publication-copy h3 { max-width: 42rem; margin: 0.8rem 0 1rem; color: var(--paper); font-size: clamp(1.8rem, 4vw, 3.8rem); line-height: 0.98; }
  .publication-copy h3 a { color: inherit; text-decoration: none; }
  .publication-copy h3 a:hover, .articles-cta:hover { color: var(--gold); }
  .publication-copy > p:not(.interior-eyebrow):not(.publication-byline) { max-width: 42rem; color: var(--muted-ink); line-height: 1.65; }
  .publication-byline { color: var(--paper); line-height: 1.5; }
  .publication-topics { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; padding: 0; list-style: none; color: var(--muted-ink); font-size: 0.78rem; }
  .publication-topics li:not(:last-child)::after { content: " /"; margin-left: 0.8rem; color: var(--gold); }
  .articles-cta { display: inline-block; margin-top: 1.25rem; color: var(--paper); font-size: 0.78rem; letter-spacing: 0.1em; text-decoration: none; text-transform: uppercase; }
  .articles-cta span { color: var(--gold); }
  .theme-list { border-top: 1px solid var(--section-line); }
  .theme-link { display: grid; grid-template-columns: 3rem minmax(0, 1fr) 2rem; gap: 1.5rem; align-items: start; padding: 1.5rem 0; border-bottom: 1px solid var(--section-line); color: var(--paper); text-decoration: none; }
  .theme-link:hover { color: var(--gold); }
  .theme-number { color: var(--gold); font-size: 0.75rem; letter-spacing: 0.1em; }
  .theme-link strong { display: block; font-size: 1.1rem; letter-spacing: 0.12em; }
  .theme-link small { display: block; max-width: 48rem; margin-top: 0.45rem; color: var(--muted-ink); font-size: 0.95rem; line-height: 1.5; }
  .theme-arrow { justify-self: end; font-size: 1.3rem; }
  .articles-archive-heading { align-items: end; }
  .articles-search { display: grid; gap: 0.45rem; min-width: min(100%, 20rem); color: var(--muted-ink); font-size: 0.78rem; }
  .articles-search input { width: 100%; padding: 0.7rem 0; border: 0; border-bottom: 1px solid var(--section-line); border-radius: 0; outline: none; background: transparent; color: var(--paper); font: inherit; }
  .articles-search input:focus { border-bottom-color: var(--gold); }
  .articles-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .articles-filters button { padding: 0.45rem 0.8rem; border: 1px solid var(--section-line); background: transparent; color: var(--muted-ink); font: inherit; cursor: pointer; }
  .articles-filters button.is-active, .articles-filters button:hover, .articles-filters button:focus-visible { border-color: var(--paper); color: var(--paper); }
  .articles-list { border-top: 1px solid var(--section-line); }
  .articles-list-item { display: grid; grid-template-columns: 10rem minmax(0, 1fr) 2rem; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--section-line); }
  .articles-list-item[hidden] { display: none; }
  .articles-list-meta span { display: block; margin-top: 0.75rem; color: var(--muted-ink); font-size: 0.78rem; }
  .articles-list-copy h3 { margin: 0 0 0.5rem; color: var(--paper); font-size: clamp(1.2rem, 2vw, 1.8rem); line-height: 1.1; }
  .articles-list-copy h3 a { color: inherit; text-decoration: none; }
  .articles-list-copy h3 a:hover, .articles-list-arrow:hover { color: var(--gold); }
  .articles-list-copy > p { max-width: 48rem; margin: 0; color: var(--muted-ink); line-height: 1.55; }
  .articles-list-copy .articles-tags { margin-top: 0.75rem; font-size: 0.78rem; }
  .articles-list-arrow { justify-self: end; color: var(--paper); font-size: 1.4rem; text-decoration: none; }
  .articles-empty { margin-top: 1.5rem; color: var(--muted-ink); }
  .articles-closing { padding-top: 2rem; border-top: 1px solid var(--section-line); }
  .articles-closing h2 { max-width: 46rem; margin: 0.8rem 0 1.5rem; color: var(--paper); font-size: clamp(2rem, 5vw, 4.5rem); line-height: 0.98; }
  .articles-closing-copy { max-width: 42rem; color: var(--muted-ink); line-height: 1.65; }
  .articles-closing-copy p { margin: 0.5rem 0; }
  .articles-closing-actions { display: flex; flex-wrap: wrap; gap: 2rem; margin-top: 1.5rem; }
  @media (max-width: 800px) {
    .articles-hero { grid-template-columns: 1fr; gap: 1rem; }
    .articles-hero-copy { padding-bottom: 1rem; }
    .articles-hero-image { max-height: 20rem; }
    .editorial-section { margin-top: 4.5rem; }
    .articles-section-heading, .articles-archive-heading { display: block; }
    .articles-section-note, .articles-search { margin-top: 1.5rem; }
    .featured-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .publication-spread, .publication-spread:nth-child(even) { grid-template-columns: 1fr; gap: 1.5rem; }
    .publication-spread:nth-child(even) .publication-image-link { order: 0; }
    .publication-image-link img { max-height: 31rem; }
    .theme-link { grid-template-columns: 2rem minmax(0, 1fr) 1.5rem; gap: 1rem; }
    .articles-list-item { grid-template-columns: 1fr 2rem; gap: 0.8rem 1rem; }
    .articles-list-meta { grid-column: 1 / -1; }
    .articles-list-meta span { display: inline; margin-left: 0.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .articles-page *, .articles-page *::before, .articles-page *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
  }
</style>
