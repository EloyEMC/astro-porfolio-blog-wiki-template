---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { siteConfig } from '../../config'; // Importa siteConfig
import { filterPublishedPosts, getRandomPosts, getRelatedPosts } from '../../utils/posts';




export async function getStaticPaths() {
  const siteUrl = siteConfig.site; // Usa siteConfig.site
  const defaultImage = siteConfig.defaultImage || siteConfig.image || "";

      const posts = filterPublishedPosts(await getCollection('blog'));
      return posts.map((post) => {
        const relatedPosts = getRelatedPosts(posts, post);
        const randomPosts = getRandomPosts(posts, post, relatedPosts);

        return {
          params: { slug: post.slug },
          props: {
            post,
            siteUrl,
            defaultImage,
            relatedPosts,
            randomPosts,
            author: post.data.author,
          },
        };
      });

}

const { post, siteUrl, defaultImage, author, relatedPosts, randomPosts } = Astro.props;
const { Content, headings } = await post.render();
---

    <BlogPost
      post={post}
      siteUrl={siteUrl}
      defaultImage={defaultImage}
      author={author}
      headings={headings}
      relatedPosts={relatedPosts}
      randomPosts={randomPosts}
    >
  <Content />
</BlogPost>