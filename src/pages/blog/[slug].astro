---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { siteConfig } from '../../config'; // Importa siteConfig




export async function getStaticPaths() {
  const siteUrl = siteConfig.site; // Usa siteConfig.site
  const defaultImage = `${siteUrl}/default-image.png`; // Imagen por defecto para SEO

  const posts = await getCollection('blog');
  return posts.map((post) => ({
  params: { slug: post.slug },
  props: { 
    post, 
    siteUrl, 
    defaultImage,
    author: post.data.author // ✅ Ahora está dentro de props
  },
}));

}

const { post, siteUrl, defaultImage, author } = Astro.props;
const { Content } = await post.render();
---

<BlogPost  post={post} siteUrl={siteUrl} defaultImage={defaultImage} author={author}>
  <article class="prose dark:prose-dark"> 
  <Content />
</BlogPost>