---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths() { return (await getCollection('blog')).filter((post) => !post.data.draft).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props; const { Content } = await render(post);
---
<BaseLayout title={post.data.title} description={post.data.description} slug={`blog/${post.id}`}><article class="editorial-article"><p class="interior-eyebrow">{post.data.category} · {post.data.date.toLocaleDateString()}</p><h1>{post.data.title}</h1>{post.data.description && <p class="lede">{post.data.description}</p>}<div class="prose"><Content /></div></article></BaseLayout>
