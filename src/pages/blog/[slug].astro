---
import { getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const siteUrl = import.meta.env.SITE_URL; // URL base del sitio
  const defaultImage = `${siteUrl}/default-image.png`; // Imagen por defecto para SEO

  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, siteUrl, defaultImage },
  }));
}

const { post, siteUrl, defaultImage } = Astro.props;
const { Content } = await post.render();
---

<BlogPost post={post} siteUrl={siteUrl} defaultImage={defaultImage}>
  <Content />
</BlogPost>