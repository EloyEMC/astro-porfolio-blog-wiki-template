---
import InteriorLayout from "../../layouts/InteriorLayout.astro";

const featuredProjects = [
  {
    id: "gaeta-huguet",
    image: "/gaeta-huguet.jpg",
    alt: "Estadio de atletismo Gaetà Huguet",
    name: "Gaetà Huguet",
    location: "Castellón de la Plana",
    category: "Sport Outdoor",
    href: "https://www.disano.it/es/p/proyectos/stadio-di-atletica-gaeta-huguet/",
  },
  {
    id: "parque-la-siesta",
    image: "/parque-la-siesta.jpg",
    alt: "Parque La Siesta de Torrevieja",
    name: "Parque La Siesta",
    location: "Torrevieja · Alicante",
    category: "Relax",
    href: "https://www.disano.it/es/p/proyectos/parque-la-siesta-de-torrevieja/",
  },
  {
    id: "gandia-atletismo",
    image: "/gandia-atletismo.jpg",
    alt: "Pista de atletismo en Gandía",
    name: "Pista de atletismo en Gandía",
    location: "Gandía",
    category: "Sport Outdoor",
    href: "https://www.disano.it/es/p/proyectos/pista-de-atletismo-en-gandia/",
  },
];

const pendingProjects = [
  "Colegio Internacional Vallemar",
  "Central FGVA",
  "Casa Ruano",
  "Centro Arqueológico de Bullas",
];
---

<InteriorLayout
  title="Proyectos de iluminación y tecnología | Eloy Martínez Cuesta"
  description="Proyectos de iluminación profesional, herramientas digitales, APIs y software desarrollados a partir de problemas reales y más de 20 años de experiencia."
  slug="proyectos"
>
  <div class="projects-page">
    <header class="projects-header">
      <p class="interior-eyebrow">03 / Proyectos</p>
      <h1 id="projects-title" class="interior-title">Proyectos reales.</h1>
      <p class="projects-declaration">Del problema a la solución.</p>
      <p class="interior-intro">Una selección de proyectos, herramientas y experimentos nacidos de necesidades concretas.</p>
      <p class="projects-intro-detail">Algunos pertenecen a la iluminación profesional. Otros al software, los datos o la automatización. Todos comparten la misma forma de trabajar: entender primero el problema y construir después la solución.</p>
      <nav class="projects-nav" aria-label="Secciones de proyectos">
        <a href="#iluminacion">Iluminación</a>
        <a href="#herramientas">Herramientas</a>
        <a href="#open-source">Open source</a>
        <a href="#laboratorio">Laboratorio</a>
      </nav>
      <figure class="projects-hero">
        <img src="/proyecto-estadio.webp" alt="Estadio iluminado al anochecer" fetchpriority="high" />
        <figcaption>La luz también construye la experiencia de un lugar.</figcaption>
      </figure>
    </header>

    <section id="iluminacion" class="projects-section projects-lighting" aria-labelledby="lighting-title">
      <p class="interior-eyebrow">ILUMINACIÓN / EXPERIENCIA</p>
      <h2 id="lighting-title">Más de 20 años convirtiendo necesidades en proyectos.</h2>
      <p class="section-lead">Proyectos deportivos, espacios públicos, arquitectura, patrimonio, educación e infraestructuras.</p>
      <p class="section-lead">Cada proyecto plantea problemas diferentes. El trabajo consiste en entenderlos y encontrar una solución de iluminación coherente con el espacio, las necesidades técnicas y las personas que van a utilizarlo.</p>
      <div class="featured-grid">
        {featuredProjects.map((project) => (
          <article class={`featured-project featured-project--${project.id}`}>
            <a class="project-image-link" href={project.href} target="_blank" rel="noreferrer">
              <img src={project.image} alt={project.alt} loading="lazy" />
            </a>
            <div class="project-copy">
              <p class="project-category">{project.category}</p>
              <h3><a href={project.href} target="_blank" rel="noreferrer">{project.name}</a></h3>
              <p class="project-location">{project.location}</p>
              <a class="text-link" href={project.href} target="_blank" rel="noreferrer">Ver ficha en Disano <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
      <div class="pending-projects">
        <p class="project-category">Información pendiente</p>
        <p class="pending-intro">Otros nombres que forman parte del archivo, todavía sin una ficha pública documentada aquí:</p>
        <ul>
          {pendingProjects.map((project) => <li>{project}</li>)}
        </ul>
      </div>
    </section>

    <section id="herramientas" class="projects-section" aria-labelledby="tools-title">
      <p class="interior-eyebrow">ILUMINACIÓN + SOFTWARE</p>
      <h2 id="tools-title">Cuando el conocimiento del sector se convierte en herramienta.</h2>
      <div class="tools-layout">
        <article class="tool-feature">
          <img src="/disano-tools-screenshot.png" alt="Interfaz de BC3 Suite con herramientas para trabajar con archivos PDF, Excel y BC3" loading="lazy" />
          <div>
            <p class="project-category">BC3 SUITE / DISANO TOOLS</p>
            <h3>Una familia para presupuestos y catálogo.</h3>
            <p>BC3 Suite reúne herramientas con capacidades verificadas para convertir PDF a BC3, Excel a BC3 y BC3 a Excel o PDF, con compatibilidad FIEBDC. La versión de producción está disponible para explorar.</p>
            <a class="text-link" href="https://disano.eloymartinezcuesta.com" target="_blank" rel="noreferrer">Abrir DISANO Tools <span aria-hidden="true">↗</span></a>
          </div>
        </article>
        <article class="tool-note">
          <p class="project-category">API DISANO · INFRAESTRUCTURA</p>
          <h3>Una capa de datos para integrar el catálogo.</h3>
          <p>API DISANO es una API REST construida con FastAPI para consultar el catálogo DISANO/FOSNOVA. Incluye autenticación mediante API key, endpoints de productos, familias y BC3, versión v2 y límites de uso.</p>
          <p>El acceso se gestiona para cada proyecto. <a href="mailto:eloy.martinez@disano.it">Contactar por correo</a>.</p>
        </article>
      </div>
    </section>

    <section id="open-source" class="projects-section" aria-labelledby="open-source-title">
      <p class="interior-eyebrow">SOFTWARE / OPEN SOURCE</p>
      <h2 id="open-source-title">Construir piezas que también puedan servir a otros.</h2>
      <article class="open-source-feature">
        <div>
          <p class="project-category">PROYECTO PRINCIPAL</p>
          <h3>SEO estructurado sin perder el control del contenido.</h3>
          <p>astro-seo-complement es un paquete para Astro con metadatos SEO tipados y explícitos, constructores reutilizables de Schema.org y JSON-LD, composición de grafos, serialización segura y soporte para medios y autores. Está publicado bajo licencia MIT.</p>
          <div class="project-links">
            <a class="text-link" href="https://github.com/EloyEMC/astro-seo-complement" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://www.npmjs.com/package/astro-seo-complement" target="_blank" rel="noreferrer">npm <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://astro-seo-complement.pages.dev/" target="_blank" rel="noreferrer">Demo <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    </section>

    <section id="laboratorio" class="projects-section projects-lab" aria-labelledby="lab-title">
      <p class="interior-eyebrow">LABORATORIO</p>
      <h2 id="lab-title">Aprender haciendo, sin convertir cada prueba en producto.</h2>
      <article class="lab-project">
        <div>
          <p class="project-category">ELECTRÓNICA · OPEN SOURCE</p>
          <h3>Multi-color LED indicator para Silakka54.</h3>
          <p>Un proyecto para teclado Silakka54 con una placa RP2040 Zero y un LED WS2812 conectado al GPIO16. Incluye colores por capa e indicador de bloqueo de mayúsculas. Está publicado bajo licencia MIT.</p>
          <a class="text-link" href="https://github.com/EloyEMC/Multi-color-LED-indicator-for-Silakka54-with-RP2040-Zero" target="_blank" rel="noreferrer">Ver repositorio <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>

    <footer class="projects-footer">
      <p class="interior-eyebrow">SIGUIENTE</p>
      <h2>El recorrido explica cómo se construyeron estas piezas.</h2>
      <a class="section-cta" href="/trayectoria/">Ver trayectoria <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</InteriorLayout>

<style>
  .projects-page {
    --projects-line: rgba(241, 238, 232, 0.14);
    --projects-muted: var(--muted-ink);
  }

  .projects-header { max-width: 63rem; }
  .projects-header .interior-title { max-width: 58rem; }
  .projects-hero { margin: 3rem 0 0; }
  .projects-hero img { display: block; width: 100%; aspect-ratio: 16 / 7; object-fit: cover; object-position: center; }
  .projects-hero figcaption { margin-top: 0.75rem; color: var(--projects-muted); font-size: 0.78rem; letter-spacing: 0.04em; }
  .projects-declaration { margin: 1rem 0 1.5rem; color: var(--paper); font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.2; }
  .projects-intro-detail { max-width: 48rem; color: var(--projects-muted); line-height: 1.7; }
  .projects-nav { display: flex; flex-wrap: wrap; gap: 0.7rem 1.4rem; margin-top: 2rem; }
  .projects-nav a, .text-link, .tool-note a { color: var(--paper); text-decoration: underline; text-decoration-color: rgba(241, 238, 232, 0.42); text-underline-offset: 0.25rem; }
  .projects-nav a:hover, .text-link:hover, .tool-note a:hover { text-decoration-color: var(--paper); }
  .projects-section { border-top: 1px solid var(--projects-line); margin-top: 6rem; padding-top: 2rem; }
  .projects-section h2 { max-width: 42rem; margin: 0.35rem 0 1rem; color: var(--paper); }
  .projects-page h3 { color: var(--paper); }
  .section-lead { max-width: 38rem; color: var(--projects-muted); }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; }
  .project-image-link { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #191919; }
  .project-image-link img, .tool-feature > img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 300ms ease; }
  .project-image-link:hover img { transform: scale(1.02); }
  .project-copy { padding-top: 1rem; }
  .project-category { margin: 0 0 0.7rem; color: var(--projects-muted); font-size: 0.72rem; letter-spacing: 0.13em; text-transform: uppercase; }
  .project-copy h3, .tool-feature h3, .tool-note h3, .open-source-feature h3, .lab-project h3 { margin: 0; font-size: clamp(1.35rem, 2.5vw, 2rem); }
  .project-copy h3 a { color: var(--paper); text-decoration: none; }
  .project-location { margin: 0.45rem 0 1rem; color: var(--projects-muted); }
  .pending-projects { border-top: 1px solid var(--projects-line); margin-top: 4rem; padding-top: 1.5rem; max-width: 45rem; }
  .pending-intro { color: var(--projects-muted); margin: 0; }
  .pending-projects ul { columns: 2; list-style: none; margin: 1rem 0 0; padding: 0; }
  .pending-projects li { border-bottom: 1px solid var(--projects-line); padding: 0.65rem 0; }
  .tools-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(15rem, 0.75fr); gap: 2rem; margin-top: 3rem; }
  .tool-feature { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(15rem, 1fr); gap: 1.5rem; align-items: start; }
  .tool-feature > img { aspect-ratio: 1.42; object-fit: cover; }
  .tool-feature p, .tool-note p, .open-source-feature p, .lab-project p { color: var(--projects-muted); }
  .tool-note, .open-source-feature, .lab-project { border-left: 1px solid var(--projects-line); padding-left: 1.5rem; }
  .tool-note h3 { font-size: 1.5rem; margin-bottom: 1rem; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .open-source-feature { max-width: 48rem; margin-top: 2.5rem; }
  .projects-lab { padding-bottom: 1rem; }
  .lab-project { max-width: 43rem; margin-top: 2.5rem; }
  .projects-footer { border-top: 1px solid var(--projects-line); margin-top: 6rem; padding: 2rem 0 1rem; }
  .projects-footer h2 { max-width: 38rem; color: var(--paper); }
  .projects-page .section-cta { display: inline-block; margin-top: 2rem; color: var(--paper); font-size: 0.75rem; letter-spacing: 0.1em; text-decoration: none; text-transform: uppercase; }
  .projects-page .section-cta span { color: var(--gold); }
  .projects-page .section-cta:hover, .projects-page .section-cta:focus-visible { color: var(--paper); text-decoration: none; }

  @media (max-width: 760px) {
    .projects-section { margin-top: 4rem; }
    .featured-grid, .tools-layout, .tool-feature { grid-template-columns: 1fr; gap: 1.5rem; }
    .pending-projects ul { columns: 1; }
    .tool-note, .open-source-feature, .lab-project { border-left: 0; border-top: 1px solid var(--projects-line); padding: 1.5rem 0 0; }
  }
</style>
