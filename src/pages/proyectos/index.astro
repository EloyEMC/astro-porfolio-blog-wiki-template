---
import InteriorLayout from "../../layouts/InteriorLayout.astro";

const lightingProjects = [
  {
    id: "gaeta-huguet",
    image: "/gaeta-huguet.webp",
    alt: "Estadio de atletismo Gaetà Huguet iluminado",
    name: "Gaetà Huguet",
    location: "Castellón de la Plana",
    type: "Deporte · exterior",
    href: "https://www.disano.it/es/p/proyectos/stadio-di-atletica-gaeta-huguet/",
  },
  {
    id: "parque-la-siesta",
    image: "/parque-la-siesta.webp",
    alt: "Parque La Siesta de Torrevieja iluminado",
    name: "Parque La Siesta",
    location: "Torrevieja · Alicante",
    type: "Espacio público",
    href: "https://www.disano.it/es/p/proyectos/parque-la-siesta-de-torrevieja/",
  },
  {
    id: "gandia-atletismo",
    image: "/gandia-atletismo.webp",
    alt: "Pista de atletismo de Gandía iluminada",
    name: "Pista de atletismo en Gandía",
    location: "Gandía",
    type: "Deporte · exterior",
    href: "https://www.disano.it/es/p/proyectos/pista-de-atletismo-en-gandia/",
  },
];

const otherLightingProjects = [
  "Colegio Internacional Vallemar",
  "Central FGVA",
  "Casa Ruano",
  "Centro Arqueológico de Bullas",
];

const secondaryOpenSource = [
  { name: "web-component-library", href: "https://github.com/EloyEMC/web-component-library" },
  { name: "astro-author-box", href: "https://github.com/EloyEMC/astro-author-box" },
  { name: "astro-FAQs-complement", href: "https://github.com/EloyEMC/astro-FAQs-complement" },
];
---

<InteriorLayout
  title="Proyectos de iluminación, software y tecnología | Eloy Martínez Cuesta"
  description="Proyectos de iluminación profesional, herramientas digitales, APIs y software desarrollados a partir de problemas reales y más de 20 años de experiencia."
  slug="proyectos"
>
  <div class="projects-page">
    <header class="projects-header">
      <p class="interior-eyebrow">03 / Proyectos</p>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="interior-title">Proyectos reales.</h1>
          <p class="hero-declaration">Del problema a la solución.</p>
          <p class="hero-summary">Una selección de proyectos, herramientas y experimentos nacidos de necesidades concretas. Algunos pertenecen a la iluminación profesional. Otros al software, los datos o la automatización. Todos comparten la misma forma de trabajar: entender primero el problema y construir después la solución.</p>
          <nav class="projects-nav" aria-label="En esta sección">
            <span class="projects-nav-label">En esta sección</span>
            <a href="#iluminacion">01 Iluminación <span aria-hidden="true">↘</span></a>
            <a href="#herramientas">02 Herramientas <span aria-hidden="true">↘</span></a>
            <a href="#open-source">03 Software y open source <span aria-hidden="true">↘</span></a>
            <a href="#laboratorio">04 Laboratorio <span aria-hidden="true">↘</span></a>
          </nav>
        </div>
        <figure class="projects-hero">
          <img src="/proyecto-estadio.webp" alt="Estadio iluminado al anochecer" fetchpriority="high" />
          <figcaption><span>01</span> La luz también construye la experiencia de un lugar.</figcaption>
        </figure>
      </div>
    </header>

    <section id="iluminacion" class="projects-section lighting-section" aria-labelledby="lighting-title">
      <div class="section-heading">
        <p class="interior-eyebrow">Iluminación / 01</p>
        <h2 id="lighting-title">Más de 20 años convirtiendo necesidades en proyectos.</h2>
        <p>Proyectos deportivos, espacios públicos, arquitectura, patrimonio, educación e infraestructuras.</p>
        <p>Cada proyecto plantea problemas diferentes. El trabajo consiste en entenderlos y encontrar una solución de iluminación coherente con el espacio, las necesidades técnicas y las personas que van a utilizarlo.</p>
      </div>

      <div class="featured-grid">
        {lightingProjects.map((project, index) => (
          <article class={`featured-project featured-project--${project.id}`}>
            <a class="project-image-link" href={project.href} target="_blank" rel="noreferrer">
              <img src={project.image} alt={project.alt} loading={index === 0 ? "eager" : "lazy"} />
            </a>
            <div class="project-copy">
              <p class="project-index">0{index + 1}</p>
              <div>
                <p class="project-category">{project.type}</p>
                <h3><a href={project.href} target="_blank" rel="noreferrer">{project.name}</a></h3>
                <p class="project-location">{project.location}</p>
              </div>
              <a class="text-link" href={project.href} target="_blank" rel="noreferrer">Ver ficha en Disano <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>

      <aside class="more-projects" aria-labelledby="more-projects-title">
        <div>
          <p class="project-category">Archivo de proyectos</p>
          <h3 id="more-projects-title">Más proyectos</h3>
        </div>
        <p>Otros nombres del archivo, todavía sin una ficha pública documentada aquí.</p>
        <ul>
          {otherLightingProjects.map((project) => <li>{project}</li>)}
        </ul>
      </aside>
    </section>

    <section id="herramientas" class="projects-section software-section" aria-labelledby="software-title">
      <div class="section-heading">
        <p class="interior-eyebrow">Iluminación + software / 02</p>
        <h2 id="software-title">Cuando el conocimiento del sector se convierte en herramienta.</h2>
      </div>

      <div class="software-grid">
        <article class="bc3-feature">
          <div class="feature-image"><img src="/disano-tools-screenshot.webp" alt="Interfaz de BC3 Suite con herramientas para trabajar con archivos PDF, Excel y BC3" loading="lazy" /></div>
          <div class="feature-content">
            <p class="project-category">BC3 Suite · familia de herramientas</p>
            <h3>Presupuestos y catálogo, en el mismo flujo.</h3>
            <p>BC3-Suite es una plataforma profesional para trabajar con presupuestos BC3/FIEBDC-3. La familia reúne conversión PDF/Excel, CRM, visibilidad geográfica, catálogo externo y exportaciones a BC3, Excel y PDF.</p>
            <a class="text-link" href="https://disano.eloymartinezcuesta.com" target="_blank" rel="noreferrer">Explorar DISANO Tools <span aria-hidden="true">↗</span></a>
          </div>
        </article>

        <article class="api-feature">
          <p class="project-category">API DISANO · proyecto independiente</p>
          <h3>Datos de catálogo preparados para integrarse.</h3>
          <p>Una API de producción con endpoints documentados para productos, familias y BC3. Su v2 define campos estandarizados para trabajar con el catálogo DISANO/FOSNOVA.</p>
          <a class="text-link" href="https://api.eloymartinezcuesta.com/" target="_blank" rel="noreferrer">Consultar API pública <span aria-hidden="true">↗</span></a>
        </article>
      </div>
    </section>

    <section id="open-source" class="projects-section open-source-section" aria-labelledby="open-source-title">
      <div class="section-heading">
        <p class="interior-eyebrow">Open source / 03</p>
        <h2 id="open-source-title">Piezas pequeñas, criterio compartido.</h2>
      </div>
      <article class="open-source-feature">
        <div class="open-source-number" aria-hidden="true">01</div>
        <div>
          <p class="project-category">Proyecto principal · Astro</p>
          <h3>astro-seo-complement</h3>
          <p>Metadatos explícitos y tipados, constructores Schema.org, composición de grafos y serialización segura de JSON-LD para proyectos Astro. Incluye soporte para medios y autores, demo y compatibilidad con Astro 5, 6 y 7.</p>
          <div class="project-links">
            <a class="text-link" href="https://github.com/EloyEMC/astro-seo-complement" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://www.npmjs.com/package/astro-seo-complement" target="_blank" rel="noreferrer">npm <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="https://astro-seo-complement.pages.dev/" target="_blank" rel="noreferrer">Demo <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
      <div class="secondary-projects">
        <p class="project-category">También en abierto</p>
        <ul>
          {secondaryOpenSource.map((project) => <li><a href={project.href} target="_blank" rel="noreferrer">{project.name} <span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </div>
    </section>

    <section id="laboratorio" class="projects-section lab-section" aria-labelledby="lab-title">
      <div class="section-heading">
        <p class="interior-eyebrow">Laboratorio / 04</p>
        <h2 id="lab-title">No todos los proyectos tienen que convertirse en producto.</h2>
      </div>
      <article class="lab-project">
        <div class="lab-mark" aria-hidden="true">54</div>
        <div>
          <p class="project-category">Silakka54 · electrónica</p>
          <h3>Multi-color LED indicator</h3>
          <p>Algunas ideas sirven para resolver un problema. Otras para aprender, probar una tecnología o responder una pregunta. Este experimento para Silakka54 utiliza un RP2040 Zero y un LED WS2812 en GPIO16 para indicar capas, bloqueo de mayúsculas y estado persistente.</p>
          <a class="text-link" href="https://github.com/EloyEMC/Multi-color-LED-indicator-for-Silakka54-with-RP2040-Zero" target="_blank" rel="noreferrer">Ver repositorio <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    </section>

    <footer class="projects-footer">
      <p class="interior-eyebrow">Iluminación · Tecnología · Negocio</p>
      <h2>Distintas herramientas. La misma forma de trabajar.</h2>
      <p class="closing-process">Entender el contexto.<br />Definir el problema.<br />Construir una solución.<br />Comprobar el resultado.<br />Aprender y volver a empezar.</p>
      <a class="section-cta" href="/trayectoria/">Ver trayectoria <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</InteriorLayout>

<style>
  .projects-page { --projects-line: rgba(241, 238, 232, 0.15); --projects-muted: var(--muted-ink); }
  .projects-header { max-width: 70rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 0.88fr) minmax(20rem, 1.12fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; margin-top: 3.2rem; }
  .projects-header .interior-title { max-width: 42rem; margin: 0; }
  .interior-title em { color: var(--gold); font-style: normal; }
  .hero-declaration { margin: 1.25rem 0 0; color: var(--paper); font-size: clamp(1.25rem, 2vw, 1.75rem); line-height: 1.2; }
  .hero-summary { max-width: 31rem; margin: 1.5rem 0 0; color: var(--projects-muted); font-size: 1.05rem; line-height: 1.7; }
  .projects-nav { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 2.5rem; }
  .projects-nav-label { flex-basis: 100%; color: var(--gold); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; }
  .projects-nav a, .text-link, .secondary-projects a { color: var(--paper); text-decoration: underline; text-decoration-color: rgba(241, 238, 232, 0.4); text-underline-offset: 0.28rem; }
  .projects-nav a:hover, .text-link:hover, .secondary-projects a:hover { text-decoration-color: var(--gold); }
  .projects-nav span { color: var(--gold); }
  .projects-hero { margin: 0; }
  .projects-hero img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center; }
  .projects-hero figcaption { display: flex; gap: 0.8rem; margin-top: 0.8rem; color: var(--projects-muted); font-size: 0.78rem; letter-spacing: 0.03em; }
  .projects-hero figcaption span, .project-index { color: var(--gold); }
  .projects-section { border-top: 1px solid var(--projects-line); margin-top: clamp(5rem, 10vw, 10rem); padding-top: 1.5rem; }
  .section-heading { display: grid; grid-template-columns: minmax(10rem, 0.6fr) minmax(0, 1fr); column-gap: 2rem; align-items: start; }
  .section-heading .interior-eyebrow { margin: 0; }
  .section-heading h2 { max-width: 39rem; margin: 0; color: var(--paper); }
  .section-heading > p:last-child { grid-column: 2; max-width: 33rem; margin: 1rem 0 0; color: var(--projects-muted); line-height: 1.7; }
  .featured-grid { display: grid; grid-template-columns: 1.2fr 0.9fr 0.9fr; gap: clamp(1rem, 2.5vw, 2.5rem); align-items: start; margin-top: 4rem; }
  .featured-project:nth-child(2) { margin-top: 4rem; }
  .featured-project:nth-child(3) { margin-top: 8rem; }
  .project-image-link { display: block; overflow: hidden; background: #191919; }
  .project-image-link img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 300ms ease; }
  .project-image-link:hover img { transform: scale(1.025); }
  .project-copy { display: grid; grid-template-columns: auto 1fr; gap: 0 1rem; padding-top: 1rem; }
  .project-index { grid-row: span 2; margin: 0; font-size: 0.8rem; }
  .project-category { margin: 0 0 0.55rem; color: var(--projects-muted); font-size: 0.7rem; letter-spacing: 0.13em; text-transform: uppercase; }
  .projects-page h3 { color: var(--paper); }
  .project-copy h3 { margin: 0; font-size: clamp(1.2rem, 2vw, 1.7rem); }
  .project-copy h3 a { color: inherit; text-decoration: none; }
  .project-location { margin: 0.35rem 0 1rem; color: var(--projects-muted); }
  .project-copy .text-link { grid-column: 2; justify-self: start; }
  .more-projects { display: grid; grid-template-columns: minmax(10rem, 0.6fr) minmax(12rem, 0.8fr) minmax(0, 1fr); gap: 1.5rem; border-top: 1px solid var(--projects-line); margin-top: 5rem; padding-top: 1.5rem; }
  .more-projects h3 { margin: 0; font-size: 1.4rem; }
  .more-projects > p { max-width: 16rem; margin: 0; color: var(--projects-muted); line-height: 1.55; }
  .more-projects ul { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; margin: 0; padding: 0; list-style: none; }
  .more-projects li { border-bottom: 1px solid var(--projects-line); padding: 0.45rem 0; }
  .software-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(16rem, 0.7fr); gap: clamp(2rem, 5vw, 5rem); margin-top: 4rem; }
  .bc3-feature { display: grid; grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .feature-image img { display: block; width: 100%; aspect-ratio: 1.35; object-fit: cover; }
  .feature-content h3, .api-feature h3, .open-source-feature h3, .lab-project h3 { margin: 0 0 1rem; font-size: clamp(1.35rem, 2.3vw, 2rem); }
  .feature-content p:not(.project-category), .api-feature p:not(.project-category), .open-source-feature p:not(.project-category), .lab-project p:not(.project-category) { color: var(--projects-muted); line-height: 1.7; }
  .api-feature, .lab-project { border-left: 1px solid var(--projects-line); padding-left: 1.5rem; }
  .open-source-feature { display: grid; grid-template-columns: 5rem minmax(0, 38rem); gap: 1.5rem; margin-top: 4rem; }
  .open-source-number, .lab-mark { color: var(--gold); font-size: 2rem; line-height: 1; }
  .project-links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1.5rem; }
  .secondary-projects { border-top: 1px solid var(--projects-line); margin-top: 4rem; padding-top: 1.25rem; }
  .secondary-projects ul { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin: 0; padding: 0; list-style: none; }
  .secondary-projects li { font-size: 0.9rem; }
  .lab-project { display: grid; grid-template-columns: 5rem minmax(0, 34rem); gap: 1.5rem; margin-top: 4rem; }
  .projects-footer { border-top: 1px solid var(--projects-line); margin-top: clamp(5rem, 10vw, 10rem); padding: 2rem 0 1rem; }
  .projects-footer h2 { max-width: 35rem; margin: 0.5rem 0 0; color: var(--paper); }
  .closing-process { margin: 1.5rem 0 0; color: var(--projects-muted); line-height: 1.8; }
  .section-cta { display: inline-block; margin-top: 2rem; color: var(--paper); font-size: 0.75rem; letter-spacing: 0.1em; text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 0.4rem; text-transform: uppercase; }
  .section-cta span { color: var(--gold); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 3rem; }
    .projects-hero { max-width: 38rem; margin-left: auto; }
    .featured-grid { grid-template-columns: repeat(2, 1fr); }
    .featured-project:nth-child(3) { grid-column: 1 / -1; max-width: 48%; margin-top: 3rem; }
    .software-grid { grid-template-columns: 1fr; }
    .api-feature { border-left: 0; border-top: 1px solid var(--projects-line); padding: 1.5rem 0 0; }
  }
  @media (max-width: 620px) {
    .hero-grid { margin-top: 2rem; }
    .projects-hero img { aspect-ratio: 4 / 3; }
    .section-heading, .more-projects, .bc3-feature, .open-source-feature, .lab-project { display: block; }
    .section-heading h2 { margin-top: 0.8rem; }
    .section-heading > p:last-child { margin-top: 1rem; }
    .featured-grid { display: block; margin-top: 3rem; }
    .featured-project, .featured-project:nth-child(2), .featured-project:nth-child(3) { max-width: none; margin: 0 0 3rem; }
    .project-image-link img { aspect-ratio: 4 / 3; }
    .more-projects > p { margin: 1rem 0; }
    .more-projects ul { grid-template-columns: 1fr; }
    .bc3-feature .feature-content { margin-top: 1.5rem; }
    .api-feature, .lab-project { margin-top: 3rem; }
    .open-source-number, .lab-mark { margin-bottom: 1rem; }
    .secondary-projects ul { display: block; }
    .secondary-projects li { padding: 0.5rem 0; }
  }
</style>
