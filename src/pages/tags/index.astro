---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllTags, getPostsByTag } from '../../utils/posts';

const posts = await getCollection('blog');
const tags = getAllTags(posts);
const tagCounts = tags.map(tag => ({
  name: tag,
  count: getPostsByTag(posts, tag).length
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="Etiquetas | Eloy Martínez Cuesta" slug="tags" noindex>
<h1 class="editorial-page-title">Categorías y Etiquetas</h1>

  <div class="editorial-tag-grid">
    {tagCounts.map(({ name, count }) => (
      <a
        href={`/tags/${name}`}
        class="editorial-tag-card"
      >
        <div class="flex items-center justify-between">
<span class="editorial-tag-name">#{name}</span>
          <span class="editorial-tag-count">{count} posts</span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>