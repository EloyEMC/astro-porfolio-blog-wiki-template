---
import { getCollection, render } from "astro:content";
import InteriorLayout from "../../../layouts/InteriorLayout.astro";
import LightingWikiBreadcrumbs from "../../../components/LightingWikiBreadcrumbs.astro";
import { LIGHTING_WIKI_CATEGORY_LABELS, lightingWikiUrl, resolveRelatedArticles, resolveRelatedTerms } from "../../../utils/lightingWiki";
import { siteConfig } from "../../../config";

export async function getStaticPaths() {
  const terms = (await getCollection("lightingWiki")).filter((term) => !term.data.draft);
  return terms.map((term) => ({ params: { slug: term.id }, props: { term } }));
}

const { term } = Astro.props;
const { Content } = await render(term);
const wikiTerms = await getCollection("lightingWiki");
const blogPosts = await getCollection("blog");
const relatedTerms = resolveRelatedTerms(term.data.relatedTerms, wikiTerms, term.id);
const relatedArticles = resolveRelatedArticles(term.data.relatedArticles, blogPosts);
const { title, category, shortDefinition, aliases, unit, symbol, image, imageAlt, imageCaption, imageCredit, seoTitle, description, keywords, faqs } = term.data;
const canonicalUrl = `${siteConfig.site}${lightingWikiUrl(term.id)}`;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: siteConfig.title, item: siteConfig.site },
    { "@type": "ListItem", position: 2, name: "Wiki de iluminación", item: `${siteConfig.site}/wiki/iluminacion/` },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
  ],
};
const definedTermSchema = {
  "@context": "https://schema.org",
  "@type": "DefinedTerm",
  name: title,
  description: shortDefinition,
  url: canonicalUrl,
  inLanguage: "es-ES",
  inDefinedTermSet: { "@type": "DefinedTermSet", name: "Wiki de iluminación", url: `${siteConfig.site}/wiki/iluminacion/` },
  termCode: symbol,
};
---

<InteriorLayout title={seoTitle || `${title} | Wiki de iluminación`} description={description || shortDefinition} image={image} image_alt={imageAlt} keywords={keywords} slug={lightingWikiUrl(term.id)}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)}></script>
  {faqs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) })}></script>}

  <article class="lighting-wiki-term-page">
    <LightingWikiBreadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Wiki de iluminación", href: "/wiki/iluminacion/" }, { label: title }]} />
    <header class="lighting-wiki-term-header">
      <p class="interior-eyebrow">{LIGHTING_WIKI_CATEGORY_LABELS[category]}</p>
      <h1 class="interior-title">{title}</h1>
      <p class="lighting-wiki-term-definition">{shortDefinition}</p>
      {(unit || symbol || aliases.length > 0) && <dl class="lighting-wiki-facts">
        {unit && <div><dt>Unidad</dt><dd>{unit}</dd></div>}
        {symbol && <div><dt>Símbolo</dt><dd>{symbol}</dd></div>}
        {aliases.length > 0 && <div><dt>También se conoce como</dt><dd>{aliases.join(", ")}</dd></div>}
      </dl>}
    </header>
    {image && <figure class="lighting-wiki-figure"><img src={image} alt={imageAlt || title} loading="eager" decoding="async" /><figcaption>{imageCaption}{imageCredit && <span class="lighting-wiki-figure-credit">{imageCredit}</span>}</figcaption></figure>}
    <div class="lighting-wiki-body prose"><Content /></div>

    <section class="lighting-wiki-relations editorial-section" aria-labelledby="related-terms-title">
      <p class="interior-eyebrow">PARA SEGUIR EXPLORANDO</p>
      <h2 id="related-terms-title">Relaciones del término.</h2>
      {relatedTerms.length > 0 ? <div class="lighting-wiki-grid">{relatedTerms.map((relatedTerm) => <article class="lighting-wiki-card"><p class="interior-eyebrow">{LIGHTING_WIKI_CATEGORY_LABELS[relatedTerm.data.category]}</p><h3><a href={lightingWikiUrl(relatedTerm.id)}>{relatedTerm.data.title}</a></h3><p>{relatedTerm.data.shortDefinition}</p></article>)}</div> : <p class="lighting-wiki-empty-inline">Todavía no hay términos relacionados publicados.</p>}
    </section>

    <section class="lighting-wiki-relations editorial-section" aria-labelledby="related-articles-title">
      <p class="interior-eyebrow">DESDE EL BLOG</p>
      <h2 id="related-articles-title">Artículos relacionados.</h2>
      {relatedArticles.length > 0 ? <div class="lighting-wiki-article-links">{relatedArticles.map((article) => <a href={`/blog/${article.id}/`}><strong>{article.data.title}</strong>{article.data.description && <span>{article.data.description}</span>}</a>)}</div> : <p class="lighting-wiki-empty-inline">Todavía no hay artículos relacionados publicados.</p>}
    </section>
  </article>
</InteriorLayout>
