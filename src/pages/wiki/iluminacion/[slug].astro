---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export async function getStaticPaths() { return (await getCollection('wiki')).filter((term) => !term.data.draft).map((term) => ({ params: { slug: term.id }, props: { term } })); }
const { term } = Astro.props; const { Content } = await render(term);
---
<BaseLayout title={`${term.data.title} — Wiki`} description={term.data.shortDefinition} slug={`wiki/iluminacion/${term.id}`}><article class="editorial-article"><p class="interior-eyebrow">WIKI / {term.data.category}</p><h1>{term.data.title}</h1><p class="lede">{term.data.shortDefinition}</p><div class="prose"><Content /></div></article></BaseLayout>
