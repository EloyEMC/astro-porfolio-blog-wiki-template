---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { wikiUrl } from '../../../utils/wiki';
const terms = (await getCollection('wiki')).filter((term) => !term.data.draft);
---
<BaseLayout title="Wiki — Your Site" slug="wiki/iluminacion"><section class="editorial-section"><p class="interior-eyebrow">OPTIONAL WIKI</p><h1>A small knowledge base.</h1><p>This generic wiki route is ready for definitions, references, and durable project context. Rename the <code>/wiki/iluminacion/</code> segment in the page and <code>src/utils/wiki.ts</code> if your project needs a different URL.</p><div class="editorial-post-list">{terms.map((term) => <article><h2><a href={wikiUrl(term.id)}>{term.data.title}</a></h2><p>{term.data.shortDefinition}</p></article>)}</div></section></BaseLayout>
